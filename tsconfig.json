{
  "compilerOptions": {
    "lib": ["esnext"],
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "target": "esnext",
    "typeRoots" : ["./node_modules/@types", "./src/types"],
    // TypeScript 6 no longer loads every typeRoots package by default; mocha
    // is listed because ts-node compiles test/ with this config
    "types": ["node", "mocha", "multihashes"]
  },
  "include": [
    "src/**/*.ts",
    "src/types/*.ts.d"
  ]
}
